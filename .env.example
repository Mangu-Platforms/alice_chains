# ─── Database ────────────────────────────────────────────────────────────────
# MySQL 8. docker-compose.yml provisions this for you.
DATABASE_URL=mysql://alice:alice_pw@localhost:3306/alice_chains

# ─── Kimi OAuth 2.0 ──────────────────────────────────────────────────────────
# MUST be the provider ORIGIN only - no path. The server refuses to boot
# otherwise, naming the corrected value.
#
# Despite the VITE_ prefix these two are read on the SERVER only. Since S-4 the
# client builds no provider URL at all: it links to /api/oauth/login and the
# server owns the authorize URL, the state and the PKCE challenge. The prefix is
# historical - see BACKLOG H-7.
# The app derives every endpoint from it:
#   authorize -> ${VITE_KIMI_AUTH_URL}/oauth/authorize
#   token     -> ${VITE_KIMI_AUTH_URL}/api/oauth/token
#   userinfo  -> ${VITE_KIMI_AUTH_URL}/api/oauth/userinfo
# Setting a full authorize URL here (the previous sample did) produces
# ".../oauth/authorize/oauth/authorize" and sign-in fails. See SECURITY.md 3.3.
VITE_KIMI_AUTH_URL=https://auth.example.com
VITE_APP_ID=your-app-id

# Server-side only. NEVER prefix a secret with VITE_ - Vite inlines every VITE_*
# variable into the public client bundle. The server refuses to start if any
# VITE_-prefixed variable looks like a secret (SEC-C-24).
#
# Must be at least 32 characters:
#   openssl rand -base64 32
APP_SECRET=change-me-at-least-32-random-characters

# ─── Session ─────────────────────────────────────────────────────────────────
# Historical name. Sessions are HMAC-SHA256 signed cookies, not JWTs; a rename
# to SESSION_SECRET is planned (ADR-002). The server REFUSES TO START below 32
# characters - a one-character key made every session forgeable.
#   openssl rand -base64 32
JWT_SECRET=change-me-at-least-32-random-characters

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
API_PORT=3001
NODE_ENV=development

# Canonical public origin - an ORIGIN, no path. This is the value both legs of
# the OAuth exchange use to build redirect_uri, so they match byte for byte.
# Required in production and behind ANY reverse proxy, including the Vite dev
# proxy: the inbound Host there is :3001 but the browser used :3000.
PUBLIC_BASE_URL=http://localhost:3000

# ─── Optional ────────────────────────────────────────────────────────────────
# Union id of the instance owner. Currently parsed but unused (see SRS FR-ADMIN-01).
OWNER_UNION_ID=
