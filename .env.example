# ─── Database ────────────────────────────────────────────────────────────────
# MySQL 8. docker-compose.yml provisions this for you.
DATABASE_URL=mysql://alice:alice_pw@localhost:3306/alice_chains

# ─── Kimi OAuth 2.0 ──────────────────────────────────────────────────────────
# MUST be the provider ORIGIN only - no path. The server refuses to boot
# otherwise, naming the corrected value.
#
# Read on the SERVER only, despite KIMI_AUTH_URL/KIMI_APP_ID formerly carrying
# a VITE_ prefix. Since S-4 the client builds no provider URL at all: it links
# to /api/oauth/login and the server owns the authorize URL, the state and the
# PKCE challenge. H-7 renamed these off the VITE_ prefix, which had been
# misleading since S-4 shipped - VITE_KIMI_AUTH_URL/VITE_APP_ID still work,
# deprecated, for one release (ADR-002's migration path).
# The app derives every endpoint from it:
#   authorize -> ${KIMI_AUTH_URL}/oauth/authorize
#   token     -> ${KIMI_AUTH_URL}/api/oauth/token
#   userinfo  -> ${KIMI_AUTH_URL}/api/oauth/userinfo
# Setting a full authorize URL here (the previous sample did) produces
# ".../oauth/authorize/oauth/authorize" and sign-in fails. See SECURITY.md 3.3.
KIMI_AUTH_URL=https://auth.example.com
KIMI_APP_ID=your-app-id

# Server-side only. NEVER prefix a secret with VITE_ - Vite inlines every VITE_*
# variable into the public client bundle. The server refuses to start if any
# VITE_-prefixed variable looks like a secret (SEC-C-24).
#
# Must be at least 32 characters:
#   openssl rand -base64 32
APP_SECRET=change-me-at-least-32-random-characters

# ─── Session ─────────────────────────────────────────────────────────────────
# Sessions are HMAC-SHA256 signed cookies, not JWTs (ADR-002) - SESSION_SECRET
# is the current name; the old JWT_SECRET still works, deprecated, for one
# release. The server REFUSES TO START below 32 characters - a one-character
# key made every session forgeable.
#   openssl rand -base64 32
SESSION_SECRET=change-me-at-least-32-random-characters

# Optional. Set only while rotating SESSION_SECRET: put the OLD value here and
# the NEW value above. Tokens signed under either verify for as long as this
# stays set, so nobody is signed out mid-rotation; only the current key above
# is ever used to sign a new one. Remove this line once every session issued
# under the old key has expired (the session's fixed lifetime) - docs/SECURITY.md §10.
SESSION_SECRET_PREVIOUS=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
API_PORT=3001
NODE_ENV=development

# Canonical public origin - an ORIGIN, no path. This is the value both legs of
# the OAuth exchange use to build redirect_uri, so they match byte for byte.
# Required in production and behind ANY reverse proxy, including the Vite dev
# proxy: the inbound Host there is :3001 but the browser used :3000.
PUBLIC_BASE_URL=http://localhost:3000

# Origins allowed to call the API and open a socket (S-15). Comma-separated.
# Empty means PUBLIC_BASE_URL only, which is right for a single-origin deploy.
CORS_ORIGINS=

# Believe X-Forwarded-For for rate-limit bucketing and TLS detection. Leave
# false unless a proxy you control is in front: a client can set that header
# freely, and would otherwise choose its own rate-limit bucket.
TRUST_PROXY=false

# ─── Testing (not needed to run the app) ─────────────────────────────────────
# Integration and Socket.IO suites opt in through TEST_DATABASE_URL. Without it
# every suite wrapped in `describeIntegration` skips rather than fails, so
# `npm run validate` is green on a machine with no database — see test/README.md.
# Point it at a DIFFERENT database from DATABASE_URL: the harness truncates
# every table between tests.
TEST_DATABASE_URL=

# `npm run db:verify-migration` creates and drops a scratch database to prove
# migration 0002 survives a dirty table, so it needs an account that may CREATE
# DATABASE — usually root, and usually not the account the app runs as. Falls
# back to DATABASE_URL, then TEST_DATABASE_URL, when unset.
ADMIN_DATABASE_URL=

# ─── Optional ────────────────────────────────────────────────────────────────
# Union id of the instance owner - the provider's identifier for the account
# that should be this deployment's administrator (S-18).
#
# Leave it unset and the deployment has NO administrator: every administrative
# procedure returns FORBIDDEN. That is the safe default; an instance that was
# never told who owns it should not decide on its own.
#
# The role is re-asserted on every sign-in, so changing this moves the
# administrator rather than adding a second one.
OWNER_UNION_ID=

# ─── Attachment storage (F-4) ────────────────────────────────────────────────
# "local" writes files to STORAGE_LOCAL_DIR and needs no extra service, which
# is why it is the default - `npm run dev` and `docker compose up` both give a
# working attachment flow out of the box.
#
# "s3" talks to MinIO or S3 and is required for any multi-node deployment,
# because local files live on one machine's disk. Start MinIO with:
#   docker compose --profile s3 up
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Only read when STORAGE_DRIVER=s3. The server refuses to start if any of the
# first four are missing.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=alice-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# MinIO serves path-style (http://host/bucket/key); AWS prefers virtual-host
# style. The wrong value produces a signature mismatch, not a 404.
S3_FORCE_PATH_STYLE=true

# ─── Web push (F-6) ──────────────────────────────────────────────────────────
# Optional. Leave unset and the app runs exactly as it does now, simply sending
# no notifications - there is no account to create and no dashboard to click.
#
# Generate a pair:
#   npm run generate-vapid
#
# VAPID_PRIVATE_KEY is a secret. Never prefix it with VITE_; the server refuses
# to start if you do. Rotating the pair invalidates every existing subscription:
# browsers hold the old public key, the push service rejects tokens signed by
# the new private one, and those rows are pruned on their first 403.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
